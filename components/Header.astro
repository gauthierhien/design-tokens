---
/**
 * Header partagé de la galaxie hien.design.
 * Squelette fixe (tagline à gauche, logo à droite). Le contenu vient de
 * chaque site, en général du singleton Keystatic "Header".
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { siteHref, type SiteKey } from "./sites.js";

export interface Props {
  /** Site qui affiche le header : le logo pointe vers "/" sur hien.design. */
  currentSite?: SiteKey;
  /** Texte en haut à gauche, ex. "Design Engineer". */
  tagline?: string | null;
  /** Logo du CMS (image optimisée). Sinon logoSrc, servi depuis /public. */
  logo?: ImageMetadata | null;
  logoSrc?: string;
  logoAlt?: string | null;
  /** Lien du logo. Par défaut : "/" sur hien.design, l'URL de hien.design ailleurs. */
  logoHref?: string;
}

const {
  currentSite,
  tagline,
  logo,
  logoSrc = "/gauthier-hien-logo.svg",
  logoAlt,
  logoHref,
} = Astro.props;

const alt = logoAlt || "Gauthier Hien Logo";
const logoClass = "w-48 lg:w-56 xl:w-64 h-auto";
---

<header
  class="w-full px-4 pt-4 flex flex-col gap-40 md:flex-row md:gap-0 md:items-start md:mb-80"
>
  <div class="flex justify-between md:justify-start md:gap-6 md:w-1/2">
    <div class="font-mono text-sm">
      {tagline || "Design Engineer"}
    </div>
  </div>

  <a href={logoHref ?? siteHref("home", currentSite)} class="self-end md:self-auto md:w-1/2">
    {
      logo ? (
        <Image src={logo} alt={alt} class={logoClass} />
      ) : (
        <img src={logoSrc} alt={alt} class={logoClass} />
      )
    }
  </a>
</header>
