---
/**
 * Header partagé de la galaxie hien.design.
 * Squelette fixe (tagline à gauche, logo à droite). Le contenu vient de
 * chaque site, en général du singleton Keystatic "Header".
 */
import { siteHref, type SiteKey } from "./sites.js";

export interface Props {
  /** Site qui affiche le header : le logo pointe vers "/" sur hien.design. */
  currentSite?: SiteKey;
  /** Texte en haut à gauche, ex. "Design Engineer". */
  tagline?: string | null;
  /** Chemin du logo, servi depuis /public du site. */
  logoSrc?: string;
  logoAlt?: string | null;
}

const {
  currentSite,
  tagline,
  logoSrc = "/gauthier-hien-logo.svg",
  logoAlt,
} = Astro.props;
---

<header
  class="w-full px-4 pt-4 flex flex-col gap-40 md:flex-row md:gap-0 md:items-start md:mb-80"
>
  <div class="flex justify-between md:justify-start md:gap-6 md:w-1/2">
    <div class="font-mono text-sm">{tagline || "Design Engineer"}</div>
  </div>

  <a href={siteHref("home", currentSite)} class="self-end md:self-auto md:w-1/2">
    <img
      src={logoSrc}
      alt={logoAlt || "Gauthier Hien Logo"}
      class="w-48 lg:w-56 xl:w-64 h-auto"
    />
  </a>
</header>
