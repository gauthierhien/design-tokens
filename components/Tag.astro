---
/**
 * Badge mono en capitales, encre pleine : SIDE-PROJECTS, ABOUT, SERVICES.
 * Marge basse de 1rem par défaut (au dessus d'un titre), à retirer avec
 * class="mb-0".
 */
export interface Props {
  class?: string;
}

const { class: extraClass } = Astro.props;
---

<span
  class:list={[
    "font-mono text-xs inline-block w-fit px-2 py-1 bg-foreground text-background font-normal tracking-wide uppercase",
    extraClass ?? "mb-4",
  ]}><slot /></span
>
