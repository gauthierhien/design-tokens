{
  "name": "@hien/design-tokens",
  "version": "1.4.0",
  "description": "Brand design tokens and shared Astro components for the hien.design sites",
  "license": "MIT",
  "type": "module",
  "files": [
    "theme.css",
    "DESIGN.md",
    "components"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./DESIGN.md": "./DESIGN.md",
    "./Header.astro": "./components/Header.astro",
    "./Footer.astro": "./components/Footer.astro",
    "./sites": "./components/sites.js",
    "./keystatic": "./components/keystatic.js",
    "./package.json": "./package.json",
    "./Button.astro": "./components/Button.astro",
    "./Tag.astro": "./components/Tag.astro",
    "./Thumbnail.astro": "./components/Thumbnail.astro",
    "./Carousel.astro": "./components/Carousel.astro",
    "./MeshBackground.astro": "./components/MeshBackground.astro",
    "./mesh": "./components/mesh.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauthierhien/hien-design-tokens.git"
  },
  "keywords": [
