  "peerDependencies": {
    "astro": ">=5",
    "@keystatic/core": ">=0.5",
    "@lucide/astro": ">=1",
    "@paper-design/shaders": ">=0.0.81",
    "swiper": ">=11"
  },
  "peerDependenciesMeta": {
    "swiper": {
      "optional": true
    },
    "@keystatic/core": {
      "optional": true
    }
