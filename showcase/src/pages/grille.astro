---
import Docs from "../layouts/Docs.astro";
---

<Docs
  title="Grille"
  lead="La même grille sur hien.design, feed, cv et apps : pleine largeur avec 16px de marge sous md, puis 8 colonnes sans gouttière. Le contenu occupe les colonnes 2 à 7, puis 3 à 6 dès 2xl."
>
  <section class="px-4 md:px-8 py-8 border-b border-border bg-background-muted flex flex-col gap-3">
    <span class="text-muted">
      <span class="md:hidden">sm · moins de 768px · 1 colonne</span>
      <span class="hidden md:inline 2xl:hidden">md à xl · 768 à 1535px · contenu 2 à 7</span>
      <span class="hidden 2xl:inline">2xl · 1536px et plus · contenu 3 à 6</span>
    </span>
    <div class="relative">
      <div class="hidden md:grid grid-cols-8 absolute inset-0" aria-hidden="true">
        {
          Array.from({ length: 8 }, (_, i) => (
            <div class="border-l border-border last:border-r flex items-start justify-center pt-2">
              <span class="text-muted">{i + 1}</span>
            </div>
          ))
        }
      </div>
      <div class="page-grid relative">
        <div class="page-grid-content bg-accent/60 h-40 md:mt-10 flex items-center justify-center">
          <span>.page-grid-content</span>
        </div>
      </div>
    </div>
  </section>
  <ul class="border-b border-border divide-y divide-border">
    {
      [
        ["Sous 768px", "Une colonne, 16px de marge (px-4)."],
        ["768 à 1535px", "8 colonnes, contenu en colonnes 2 à 7 (6 sur 8)."],
        ["1536px et plus", "8 colonnes, contenu en colonnes 3 à 6 (4 sur 8)."],
        ["Modules", "En-têtes de section sur 6 colonnes dès md (4 au centre), 8 en 2xl."],
      ].map(([k, v]) => (
        <li class="grid grid-cols-[25%_1fr] md:grid-cols-8 gap-4 px-4 md:px-8 py-6">
          <span class="text-muted md:col-span-2">{k}</span>
          <p class="md:col-span-6">{v}</p>
        </li>
      ))
    }
  </ul>
  <section class="px-4 md:px-8 py-12 border-b border-border">
    <h3 class="mb-6">Usage</h3>
    <pre class="bg-background-muted p-4 overflow-x-auto font-mono text-xs leading-relaxed"><code>{`<section class="px-4 page-grid">
  <div class="page-grid-content">…</div>
</section>`}</code></pre>
  </section>
</Docs>
