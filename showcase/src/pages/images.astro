---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import ImageWide from "@hien/design-tokens/ImageWide.astro";
import ImageSquare from "@hien/design-tokens/ImageSquare.astro";
import Thumbnail from "@hien/design-tokens/Thumbnail.astro";
import Lightbox from "@hien/design-tokens/Lightbox.astro";
import app1 from "../assets/app-1.png";
import app2 from "../assets/app-2.png";
import hero from "../assets/hero.jpg";
---

<Docs
  title="Images"
  lead="Image large et image carrée : fond gris, image entière avec de l'air autour (contain) ou qui remplit le cadre (cover). Légende et lien optionnels, ou ouverture de la visionneuse."
>
  <Demo label="ImageWide · carrée sur mobile, 16:9 dès md, sans légende" code={`<ImageWide image={img} alt="…" />`}>
    <ImageWide image={app1} alt="Capture d'app" />
  </Demo>
  <Demo label="ImageWide · légende et lien (flèche ↗, nouvel onglet)" code={`<ImageWide image={img} caption="Picky" href="https://…" padding="3rem" />`}>
    <ImageWide image={app2} alt="Picky" caption="Picky" href="https://apps.hien.design" padding="3rem" />
  </Demo>
  <Demo label="ImageWide · cover, 16:9 partout, légende sans lien" code={`<ImageWide image={img} fit="cover" responsive={false} caption="…" />`}>
    <ImageWide image={hero} alt="" fit="cover" responsive={false} caption="Sonepar, assistant vocal" />
  </Demo>
  <Demo label="ImageSquare · sans légende, avec légende, avec légende et lien" code={`<ImageSquare image={img} caption="Countdowns" href="https://…" />`}>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
      <ImageSquare image={app1} alt="Countdowns" />
      <ImageSquare image={app2} alt="Picky" caption="Picky" />
      <ImageSquare image={app1} alt="Countdowns" caption="Countdowns" href="https://apps.hien.design" />
    </div>
  </Demo>
  <Demo
    label="Visionneuse · un clic sur l'image ouvre la Lightbox (Échap ferme)"
    code={`<ImageSquare image={img} lightbox={{ id: "demo", index: 0 }} />
<Lightbox id="demo" images={[{ src: img, alt: "…" }]} />`}
  >
    <div class="grid grid-cols-2 gap-1">
      <ImageSquare image={app1} alt="Countdowns" lightbox={{ id: "images-demo", index: 0 }} />
      <ImageSquare image={app2} alt="Picky" lightbox={{ id: "images-demo", index: 1 }} />
    </div>
    <Lightbox id="images-demo" images={[{ src: app1, alt: "Countdowns" }, { src: app2, alt: "Picky" }]} />
  </Demo>
  <Demo label="Thumbnail · la vignette de base, sans légende ni lien" code={`<Thumbnail image={img} alt="…" aspect="square" />`}>
    <div class="grid grid-cols-2 gap-1">
      <Thumbnail image={app1} alt="Capture d'app" />
      <Thumbnail image={app2} alt="Capture d'app" />
    </div>
  </Demo>
</Docs>
