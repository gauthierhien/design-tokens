---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles.css";
import Header from "@hien/design-tokens/Header.astro";
import Footer from "@hien/design-tokens/Footer.astro";
import Button from "@hien/design-tokens/Button.astro";
import Tag from "@hien/design-tokens/Tag.astro";
import Thumbnail from "@hien/design-tokens/Thumbnail.astro";
import Carousel from "@hien/design-tokens/Carousel.astro";
import MeshBackground from "@hien/design-tokens/MeshBackground.astro";
import { Image } from "astro:assets";
import pkg from "@hien/design-tokens/package.json";
import themeCss from "@hien/design-tokens/theme.css?raw";
import app1 from "../assets/app-1.png";
import app2 from "../assets/app-2.png";
import hero from "../assets/hero.jpg";

const colors = [
  { token: "background", utility: "bg-background", note: "Canvas" },
  { token: "background-muted", utility: "bg-background-muted", note: "Surface douce, bouton secondaire" },
  { token: "foreground", utility: "bg-foreground", note: "Encre, CTA plein" },
  { token: "foreground-muted", utility: "bg-muted", note: "Légendes, texte secondaire" },
  { token: "accent", utility: "bg-accent", note: "Emphase, sélection" },
  { token: "accent-hover", utility: "bg-accent-hover", note: "Survol des moments accent" },
  { token: "border", utility: "bg-border", note: "Filets, séparation" },
  { token: "status", utility: "bg-status", note: "LED de disponibilité" },
];

// Valeurs lues dans theme.css : la vitrine ne peut pas diverger du package.
const block = (selector: string) => {
  const start = themeCss.indexOf(selector);
  const body = themeCss.slice(themeCss.indexOf("{", start) + 1, themeCss.indexOf("}", start));
  return Object.fromEntries(
    [...body.matchAll(/--([\w-]+):\s*([^;]+);/g)].map((m) => [m[1], m[2].trim()]),
  );
};
const light = block(":root {");
const dark = block(':root[data-theme="dark"] {');

const type = [
  { name: "h1", sample: "Design Engineer", el: "h1" },
  { name: "h2", sample: "What will we ship together?", el: "h2" },
  { name: "h3", sample: "Selected work", el: "h3" },
  { name: "h4", sample: "Get in touch", el: "h4" },
  { name: "lead", sample: "Interfaces précises, du Figma au code.", cls: "text-lead" },
  { name: "body", sample: "Freelance Design Engineer basé à Paris, je conçois et je code des produits numériques.", el: "p" },
  { name: "label", sample: "Available for freelance work", el: "span" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>hien.design.tokens</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("hd-theme") || "auto";
      } catch {
        document.documentElement.dataset.theme = "auto";
      }
    </script>
  </head>
  <body>
    <Header currentSite="home" tagline="Design system" />

    <main class="px-4 flex flex-col gap-32 pb-32">
      <section class="page-grid">
        <div class="page-grid-content flex flex-col gap-6">
          <span>@hien/design-tokens v{pkg.version}</span>
          <h1>hien.design.tokens</h1>
          <div class="flex gap-2" role="group" aria-label="Mode">
            {[["light", "Clair"], ["dark", "Sombre"], ["auto", "Système"]].map(([v, l]) => (
              <button type="button" data-theme-set={v} class="theme-btn font-mono text-xs uppercase px-3 py-1 rounded-full border border-border cursor-pointer">
                {l}
              </button>
            ))}
          </div>
          <p class="text-lead">
            Les tokens et les composants partagés par hien.design,
            feed.hien.design et cv.hien.design. Le squelette vit ici, le
            contenu de chaque site vit dans son Keystatic.
          </p>
        </div>
      </section>

      <section class="page-grid">
        <div class="page-grid-content">
          <h2>Couleurs</h2>
          <p class="text-muted mb-8">
            Toutes les couleurs sont en oklch. Le mode sombre s'active avec
            data-theme="dark" (ou "auto" pour suivre le système) sur html :
            les sites restent en clair tant qu'ils ne le demandent pas. En
            sombre, le fond de page est noir pur.
          </p>
        </div>
      </section>

      <section class="-mx-4">
        <ul class="w-full border-y border-border divide-y divide-border">
          <li class="hidden md:grid grid-cols-8 gap-4 py-4 px-4 text-muted">
            <span class="col-span-1">Aperçu</span>
            <span class="col-start-2 2xl:col-start-3 col-span-3 2xl:col-span-2">Token</span>
            <span class="col-start-5 col-span-2">Clair</span>
            <span class="col-start-7 col-span-2">Sombre</span>
          </li>
          {colors.map((c) => (
            <li class="grid grid-cols-[25%_1fr] items-center gap-2 py-4 px-4 md:grid-cols-8 md:gap-4 md:py-8">
              <div class="flex gap-1 md:col-start-1 md:col-span-1 md:row-start-1">
                <span class="w-8 h-8 md:w-10 md:h-10 border border-[oklch(80%_0_0/0.5)] shrink-0" style={`background: ${light[c.token]}`} title="Clair"></span>
                <span class="w-8 h-8 md:w-10 md:h-10 border border-[oklch(80%_0_0/0.5)] shrink-0" style={`background: ${dark[c.token]}`} title="Sombre"></span>
              </div>
              <div class="md:col-start-2 2xl:col-start-3 md:col-span-3 2xl:col-span-2">
                <p>{c.token}</p>
                <p class="text-muted">{c.note}</p>
              </div>
              <p class="col-start-2 md:col-start-5 md:col-span-2 font-mono text-sm font-light leading-relaxed">
                <span class="md:hidden text-muted">Clair · </span>{light[c.token]}<br />
                <span class="text-muted">{c.utility}</span>
              </p>
              <p class="col-start-2 md:col-start-7 md:col-span-2 font-mono text-sm font-light leading-relaxed">
                <span class="md:hidden text-muted">Sombre · </span>{dark[c.token]}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section class="page-grid">
        <div class="page-grid-content">
          <h2>Typographie</h2>
          <p class="text-muted mb-8">
            Geist Variable et Geist Mono Variable. Les tailles montent aux
            breakpoints md, lg, xl et 2xl : redimensionne la fenêtre.
          </p>
          <div class="flex flex-col border-t border-border">
            {type.map((t) => {
              const Tag = (t.el ?? "p") as any;
              return (
                <div class="border-b border-border py-6 flex flex-col gap-3 md:flex-row md:items-baseline md:gap-8">
                  <span class="text-muted md:w-32 shrink-0">text-{t.name}</span>
                  <Tag class={`mb-0 ${t.cls ?? ""}`}>{t.sample}</Tag>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <section class="flex flex-col gap-8">
        <div class="page-grid">
          <div class="page-grid-content">
            <h2>Grille</h2>
            <p class="text-muted">
              La même grille sur hien.design, feed, cv et apps : pleine
              largeur avec 16px de marge sous md, puis 8 colonnes sans
              gouttière. Le contenu (page-grid-content) occupe les colonnes 2
              à 7, puis 3 à 6 dès 2xl. Redimensionne la fenêtre.
            </p>
          </div>
        </div>
        <div class="-mx-4 px-4 bg-background-muted py-6 flex flex-col gap-3">
          <span class="text-muted">
            <span class="md:hidden">sm · &lt; 768px · 1 colonne</span>
            <span class="hidden md:inline 2xl:hidden">md à xl · 768 à 1535px · contenu 2 à 7</span>
            <span class="hidden 2xl:inline">2xl · ≥ 1536px · contenu 3 à 6</span>
          </span>
          <div class="relative">
            <div class="hidden md:grid grid-cols-8 absolute inset-0" aria-hidden="true">
              {Array.from({ length: 8 }, (_, i) => (
                <div class="border-l border-border last:border-r flex items-start justify-center pt-2">
                  <span class="text-muted">{i + 1}</span>
                </div>
              ))}
            </div>
            <div class="page-grid relative">
              <div class="page-grid-content bg-accent/60 h-40 md:mt-10 flex items-center justify-center">
                <span>.page-grid-content</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="page-grid">
        <div class="page-grid-content flex flex-col gap-16">
          <h2 class="mb-0">Composants</h2>

          <div class="flex flex-col gap-4">
            <span class="text-muted">Tag · @hien/design-tokens/Tag.astro</span>
            <div class="flex flex-wrap gap-2">
              <Tag class="mb-0">Side-projects</Tag>
              <Tag class="mb-0">About</Tag>
              <Tag class="mb-0">Services</Tag>
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <span class="text-muted">Button · outline, md (défaut)</span>
            <Button href="https://cv.hien.design" label="Full resume" />
            <span class="text-muted">Button · outline, lg, libellé au survol</span>
            <Button href="mailto:gauthier@hien.design" label="Get in touch" hoverLabel="gauthier@hien.design" size="lg" />
            <span class="text-muted">Button · inactif (sans lien)</span>
            <Button label="Soon" />
            <span class="text-muted">Button · overlay, sur une image</span>
            <div class="relative aspect-video overflow-hidden border border-border">
              <Image src={hero} alt="" class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute inset-0 flex items-center justify-center p-4 md:p-16">
                <Button href="https://apps.hien.design" label="Download on the App Store" variant="overlay" target="_blank" />
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <span class="text-muted">Thumbnail · square, video (carré sur mobile), wide</span>
            <div class="grid grid-cols-2 gap-1">
              <Thumbnail image={app1} alt="Capture d'app" />
              <Thumbnail image={app2} alt="Capture d'app" />
            </div>
            <Thumbnail image={app1} alt="Capture d'app" aspect="video" />
            <span class="text-muted">Thumbnail · padding none (image en cover)</span>
            <Thumbnail image={hero} alt="" aspect="wide" padding="none" />
          </div>

          <div class="flex flex-col gap-4">
            <span class="text-muted">MeshBackground · fond animé sombre (shader mesh, grain), réagit au bouton</span>
            <div class="relative aspect-video overflow-hidden theme-dark text-foreground" data-mesh-root>
              <MeshBackground />
              <div class="relative z-10 h-full flex items-center justify-center p-4 md:p-16">
                <Button href="https://apps.hien.design" label="Survole-moi" variant="outline" meshTrigger />
              </div>
            </div>
            <span class="text-muted">MeshBackground tone="light" · cartes Skills du CV, survole une carte</span>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {["Product Concepting", "Product & System Design", "Build & Ship"].map((t, i) => (
                <div class="relative aspect-[3/4] overflow-hidden border border-border" data-mesh-root data-mesh-trigger>
                  <MeshBackground tone="light" pose={i} />
                  <div class="relative z-10 h-full flex flex-col justify-end p-4 lg:p-6">
                    <h3>{t}</h3>
                  </div>
                </div>
              ))}
            </div>
            <p class="text-muted">
              Sur apps.hien.design, le même fond est fixé au viewport
              (Footer meshFixed) et visible à travers la fenêtre du hero.
            </p>
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-muted">Header et Footer · en haut et en bas de cette page</span>
            <pre class="bg-background-muted p-4 overflow-x-auto font-mono text-xs leading-relaxed"><code>{`---
import { getEntry } from "astro:content";
import Footer from "@hien/design-tokens/Footer.astro";
const footer = await getEntry("footer-data", "index");
---
<Footer currentSite="feed" {...footer?.data} />`}</code></pre>
          </div>
        </div>
      </section>
    </main>

    <Carousel
      class="pb-32"
      tag="Carousel"
      heading="Carousel"
      body="Swiper, boutons précédent et suivant, slides qui débordent de la grille."
      items={[
        { image: app1, title: "Countdowns" },
        { image: app2, title: "Picky", link: "https://apps.hien.design" },
        { image: app1, title: "Boring Countdown" },
        { image: app2, title: "Hey Calendar" },
      ]}
    />

    <Footer
      currentSite="home"
      heading="What will we ship together?"
      navLinks={[
        { label: "GitHub", href: "https://github.com/gauthierhien/hien-design-tokens" },
        { label: "hien.design", href: "https://hien.design" },
      ]}
    />
    <script>
      const sync = () => {
        const current = document.documentElement.dataset.theme;
        document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => {
          b.classList.toggle("bg-foreground", b.dataset.themeSet === current);
          b.classList.toggle("text-background", b.dataset.themeSet === current);
        });
      };
      document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) =>
        b.addEventListener("click", () => {
          document.documentElement.dataset.theme = b.dataset.themeSet;
          try {
            localStorage.setItem("hd-theme", b.dataset.themeSet ?? "auto");
          } catch {}
          sync();
        }),
      );
      sync();
    </script>
  </body>
</html>
